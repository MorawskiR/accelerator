# Flownatic - szablon konfiguracji.
#
# SKOPIUJ jako .env i wypelnij. Prawdziwy .env NIGDY nie trafia do repozytorium
# (repo jest publiczne, boty znajduja wyciekniete klucze w kilkanascie sekund).
#
# Na serwerze plik lezy w ~/flownatic-app/.env - poza katalogiem publicznym.

# ── Aplikacja ───────────────────────────────────────────────────
APP_ENV=production          # local | production
APP_DEBUG=false             # true wlacza szczegolowe bledy - NIGDY na produkcji
APP_URL=https://dobo.com.pl/ftf

# Klucz do szyfrowania tokenow Salesforce (AES-256-GCM).
# Wygeneruj: php app/bin/genkey.php
APP_KEY=

# ── Baza danych ─────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=qekbnopwvk_flownatic
DB_USER=qekbnopwvk_flownatic
DB_PASS=

# ── Salesforce (Faza 2) ─────────────────────────────────────────
SF_LOGIN_URL=https://resilient-narwhal-j9207g-dev-ed.trailblaze.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REDIRECT_URI=https://dobo.com.pl/ftf/oauth/callback
SF_API_VERSION=v67.0

# ── Claude API (Faza 4) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
