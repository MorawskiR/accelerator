{% extends "layout.twig" %}
{% block tytul %}Flow — Flownatic{% endblock %}
{% block szerokosc %}szeroka{% endblock %}

{% block pasek %}
<div class="pasek">
  <span class="marka">Flownatic</span>
  <span class="kto">
    {% if polaczona %}<span class="znacznik ok">org podłączona</span>{% endif %}
    <form method="post" action="{{ u.wyloguj }}" style="margin:0">
      <button type="submit" class="cichy">Wyloguj</button>
    </form>
  </span>
</div>
{% endblock %}

{% block tresc %}
<h1>Flow w org</h1>

{% if blad %}<div class="blad">{{ blad }}</div>{% endif %}
{% if ok %}<div class="sukces">{{ ok }}</div>{% endif %}

{% if not polaczona %}
  <div class="karta">
    <h2 style="margin-top:0">Org nie jest podłączona</h2>
    <p>Połącz się z Salesforce, żeby pobrać listę Flow. Zostaniesz przekierowany do logowania
    w swojej organizacji — Flownatic nie widzi Twojego hasła.</p>
    <p><a class="przycisk" href="{{ u.connect }}">Połącz z Salesforce</a></p>
  </div>
{% else %}
  <div class="karta">
    <div class="rzad">
      <div>
        <div class="etykieta">Podłączona organizacja</div>
        <div class="mono">{{ instancja }}</div>
      </div>
      <div class="akcje">
        <form method="post" action="{{ u.sync }}" style="margin:0">
          <button type="submit">Pobierz Flow</button>
        </form>
        <form method="post" action="{{ u.disconnect }}" style="margin:0"
              onsubmit="return confirm('Rozłączyć org? Tokeny zostaną usunięte z bazy.')">
          <button type="submit" class="cichy">Rozłącz</button>
        </form>
      </div>
    </div>
  </div>

  {% if flows is empty %}
    <div class="karta">
      <p style="margin:0">Brak Flow w bazie. Kliknij <strong>Pobierz Flow</strong>, żeby zaciągnąć
      inwentarz z org.</p>
    </div>
  {% else %}
    {# Import metadanych partiami. Formularz działa sam z siebie — jedno
       kliknięcie to jedna partia. JavaScript tylko go przejmuje i klika
       za nas w pętli, pokazując postęp. #}
    <div class="karta" id="metadane"
         data-partia="{{ u.partia }}" data-stan="{{ u.stan }}"
         data-pozostalo="{{ stan.pozostalo }}" data-wszystkie="{{ stan.wszystkie }}">
      <div class="rzad">
        <div>
          <div class="etykieta">Metadane Flow</div>
          <div class="przygaszone" id="metadane-opis">
            {% if stan.wszystkie == 0 %}
              Brak Flow w inwentarzu.
            {% elseif stan.pozostalo == 0 %}
              Wszystkie {{ stan.wszystkie }} Flow mają pobrane metadane.
            {% else %}
              Pobrane {{ stan.gotowe }} z {{ stan.wszystkie }} · zostało {{ stan.pozostalo }}
            {% endif %}
          </div>
        </div>
        <div class="akcje">
          <form method="post" action="{{ u.metadane }}" style="margin:0" id="metadane-form">
            <button type="submit" id="metadane-start" {% if stan.pozostalo == 0 %}disabled{% endif %}>
              {{ stan.pozostalo == 0 ? 'Metadane pobrane' : 'Pobierz metadane' }}
            </button>
          </form>
        </div>
      </div>

      <div class="postep" role="progressbar" aria-valuemin="0" aria-valuemax="100"
           aria-valuenow="{{ stan.procent }}" id="metadane-pasek">
        <div class="postep-slupek" id="metadane-slupek" style="width:{{ stan.procent }}%"></div>
      </div>

      <ul class="lista" id="metadane-log" hidden style="margin-top:12px"></ul>

      <noscript>
        <p class="przygaszone" style="margin:10px 0 0">Bez JavaScriptu jedno kliknięcie pobiera
        jedną partię (do 5 Flow). Klikaj, aż licznik dojdzie do zera — postęp jest zapisywany
        w bazie, więc nic nie przepada.</p>
      </noscript>
    </div>

    <form method="get" action="{{ u.flows }}" class="filtry">
      <label for="typ">Typ</label>
      <select name="typ" id="typ" onchange="this.form.submit()">
        <option value="">wszystkie</option>
        {% for t in typy %}
          <option value="{{ t }}" {{ t == wybranyTyp ? 'selected' : '' }}>{{ t }}</option>
        {% endfor %}
      </select>

      <label for="stan">Stan</label>
      <select name="stan" id="stan" onchange="this.form.submit()">
        <option value="">wszystkie</option>
        <option value="aktywne" {{ wybranyStan == 'aktywne' ? 'selected' : '' }}>aktywne</option>
        <option value="nieaktywne" {{ wybranyStan == 'nieaktywne' ? 'selected' : '' }}>nieaktywne</option>
      </select>

      <noscript><button type="submit">Filtruj</button></noscript>
      <span class="przygaszone">{{ flows|length }} z inwentarza</span>
    </form>

    <div class="tabela">
      <table>
        <thead>
          <tr>
            <th>Nazwa</th>
            <th>Typ</th>
            <th>Obiekt</th>
            <th>Wyzwalacz</th>
            <th>Wersja</th>
            <th>Stan</th>
            <th>Ryzyka</th>
          </tr>
        </thead>
        <tbody>
        {% for f in flows %}
          <tr>
            <td>
              <strong><a href="{{ u.flows }}/{{ f.id }}">{{ f.label ?: f.api_name }}</a></strong>
              <div class="mono przygaszone">{{ f.api_name }}</div>
            </td>
            <td>{{ f.process_type ?: '—' }}</td>
            <td>{{ f.trigger_object ?: '—' }}</td>
            <td>
              {{ f.trigger_type ?: '—' }}
              {% if f.record_trigger_type %}<div class="przygaszone">{{ f.record_trigger_type }}</div>{% endif %}
            </td>
            <td class="mono">{{ f.version_number ?: '—' }}</td>
            <td>
              {% if f.is_active %}
                <span class="znacznik ok">aktywny</span>
              {% else %}
                <span class="znacznik">nieaktywny</span>
              {% endif %}
            </td>
            <td>
              {% set r = ryzyka[f.id] ?? null %}
              {% if r is null %}
                <span class="przygaszone">metadane niepobrane</span>
              {% elseif r.razem == 0 %}
                <span class="znacznik ok">czysto</span>
              {% else %}
                {# Liczba + słowo, nie sam kolor. Do 2026-09-08 były tu gołe cyfry
                   i znaczenie niósł wyłącznie kolor plakietki — nieczytelne dla
                   każdego, kto nie zna kodu barw albo go nie rozróżnia. #}
                <div class="chipy" style="margin:0">
                  {% if r.ryzyka.wysokie > 0 %}
                    <span class="waga wysokie">{{ r.ryzyka.wysokie }} wysokie</span>
                  {% endif %}
                  {% if r.ryzyka.srednie > 0 %}
                    <span class="waga srednie">{{ r.ryzyka.srednie }} średnie</span>
                  {% endif %}
                  {% if r.ryzyka.niskie > 0 %}
                    <span class="waga niskie">{{ r.ryzyka.niskie }} niskie</span>
                  {% endif %}
                </div>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
{% endif %}

<script>
// Pasek postepu importu metadanych.
//
// Formularz obok dziala bez tego skryptu - jedno klikniecie to jedna partia.
// Tutaj tylko przejmujemy go i klikamy w petli, pokazujac postep. Kazda partia
// to osobne zadanie HTTP, wiec zadne z nich nie zbliza sie do limitu 180 s,
// a przerwanie w polowie nie psuje niczego: stan kolejki siedzi w bazie.
(function () {
    var karta = document.getElementById('metadane');

    if (!karta || !window.fetch) {
        return;
    }

    var form   = document.getElementById('metadane-form');
    var start  = document.getElementById('metadane-start');
    var opis   = document.getElementById('metadane-opis');
    var slupek = document.getElementById('metadane-slupek');
    var pasek  = document.getElementById('metadane-pasek');
    var log    = document.getElementById('metadane-log');

    var MAKS_PARTII = 200;   // zabezpieczenie przed petla bez konca

    function dopisz(tekst) {
        var li = document.createElement('li');
        li.textContent = tekst;
        log.appendChild(li);
        log.hidden = false;
    }

    function pokaz(stan) {
        if (typeof stan.procent === 'number') {
            slupek.style.width = stan.procent + '%';
            pasek.setAttribute('aria-valuenow', stan.procent);
        }

        opis.textContent = stan.pozostalo > 0
            ? 'Pobrane ' + stan.gotowe + ' z ' + stan.wszystkie + ' · zostalo ' + stan.pozostalo
            : 'Wszystkie ' + stan.wszystkie + ' Flow maja pobrane metadane.';
    }

    function koniec(komunikat, udane) {
        karta.classList.remove('pracuje');
        start.disabled = false;

        if (komunikat) {
            dopisz(komunikat);
        }

        if (udane) {
            // Przeladowanie, zeby tabela pokazala liczniki ryzyk dla nowych metadanych.
            window.setTimeout(function () { window.location.reload(); }, 700);
        } else {
            start.textContent = 'Wznow pobieranie';
        }
    }

    function partia(licznik) {
        if (licznik >= MAKS_PARTII) {
            koniec('Przerwane po ' + MAKS_PARTII + ' partiach. Kliknij, zeby wznowic.', false);
            return;
        }

        fetch(karta.dataset.partia, {
            method: 'POST',
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
        }).then(function (odp) {
            return odp.json().then(function (dane) {
                return { ok: odp.ok, dane: dane };
            });
        }).then(function (wynik) {
            if (!wynik.ok) {
                koniec(wynik.dane.blad || 'Blad pobierania. Postep jest zapisany.', false);
                return;
            }

            var dane = wynik.dane;
            pokaz(dane);

            if (dane.bledy && dane.bledy.length) {
                dane.bledy.forEach(dopisz);
            }

            if (dane.pozostalo === 0) {
                koniec('Gotowe. Odswiezam liste...', true);
                return;
            }

            // Partia bez jednego pobranego Flow, a kolejka stoi w miejscu:
            // dalsze petle powtorzylyby ten sam blad i tylko zjadly limit API.
            if (dane.pobrane === 0 && dane.bez_zmian === 0) {
                koniec('Import stanal - zadnego Flow nie udalo sie pobrac. '
                    + 'Popraw przyczyne i kliknij, zeby wznowic.', false);
                return;
            }

            partia(licznik + 1);
        }).catch(function () {
            // Zerwane polaczenie albo zamknieta sesja - postep i tak jest w bazie.
            koniec('Polaczenie przerwane. Postep jest zapisany, kliknij, zeby wznowic.', false);
        });
    }

    form.addEventListener('submit', function (zdarzenie) {
        zdarzenie.preventDefault();
        start.disabled = true;
        log.innerHTML = '';
        log.hidden = true;
        karta.classList.add('pracuje');
        partia(0);
    });
}());
</script>
{% endblock %}
