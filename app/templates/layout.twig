<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block tytul %}Flownatic{% endblock %}</title>
<style>
:root{
  --tlo:#f7f9fc; --plyta:#ffffff; --plyta2:#eef3fa;
  --tekst:#101828; --tekst2:#39445c; --przygaszony:#5a6782;
  --linia:#dde5f0; --akcent:#0b6fc4; --akcent2:#0b7d6e;
  --blad:#b23c0a; --blad-tlo:#fbe8dd;
  --cien:0 1px 2px rgba(16,24,40,.05), 0 8px 24px -16px rgba(16,24,40,.28);
}
@media (prefers-color-scheme: dark){
  :root{
    --tlo:#0a0f1d; --plyta:#111a2c; --plyta2:#172136;
    --tekst:#e9eefb; --tekst2:#c2cce2; --przygaszony:#8c99b8;
    --linia:#25314b; --akcent:#5cb4ff; --akcent2:#4fd8bf;
    --blad:#f08050; --blad-tlo:#2e1a12;
    --cien:0 1px 2px rgba(0,0,0,.4), 0 8px 24px -16px rgba(0,0,0,.7);
  }
}
*{box-sizing:border-box}
body{
  margin:0; background:var(--tlo); color:var(--tekst);
  font:16px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased;
}
.pasek{
  border-bottom:1px solid var(--linia); background:var(--plyta);
  padding:14px 22px; display:flex; align-items:center; justify-content:space-between; gap:16px;
}
.marka{font-weight:700; font-size:1.05rem; letter-spacing:-.02em;
  background:linear-gradient(96deg,var(--akcent),var(--akcent2));
  -webkit-background-clip:text; background-clip:text; color:transparent;}
.kto{font-size:.85rem; color:var(--przygaszony); display:flex; align-items:center; gap:12px}
.tresc{max-width:900px; margin:0 auto; padding:32px 22px 64px}
h1{font-size:1.5rem; letter-spacing:-.02em; margin:0 0 6px; text-wrap:balance}
h2{font-size:1.05rem; margin:28px 0 10px}
p{color:var(--tekst2); max-width:65ch}
.karta{background:var(--plyta); border:1px solid var(--linia); border-radius:10px;
  padding:20px 22px; box-shadow:var(--cien); margin:0 0 16px}
label{display:block; font-size:.85rem; font-weight:600; margin:0 0 6px; color:var(--tekst)}
input[type=email],input[type=password]{
  width:100%; padding:11px 13px; font:inherit; color:var(--tekst);
  background:var(--tlo); border:1px solid var(--linia); border-radius:7px;
}
input:focus{outline:2px solid var(--akcent); outline-offset:1px}
button{
  font:inherit; font-weight:600; cursor:pointer; border:0; border-radius:7px;
  padding:11px 20px; background:var(--akcent); color:#fff;
}
button:hover{filter:brightness(1.08)}
button.cichy{background:transparent; color:var(--przygaszony); padding:6px 10px;
  border:1px solid var(--linia)}
.blad{background:var(--blad-tlo); color:var(--blad); border:1px solid var(--blad);
  border-radius:7px; padding:11px 14px; font-size:.9rem; margin:0 0 16px}
.pole{margin:0 0 14px}
.przygaszone{color:var(--przygaszony); font-size:.88rem}
.znacznik{display:inline-block; font-size:.7rem; letter-spacing:.07em; text-transform:uppercase;
  padding:3px 9px; border-radius:999px; background:var(--plyta2); color:var(--przygaszony)}
ul.lista{list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:9px}
ul.lista li{padding-left:18px; position:relative; color:var(--tekst2); font-size:.94rem}
ul.lista li::before{content:""; position:absolute; left:0; top:.62em;
  width:6px; height:6px; border-radius:2px; background:var(--linia)}
.sukces{background:var(--plyta2); color:var(--akcent2); border:1px solid var(--akcent2);
  border-radius:7px; padding:11px 14px; font-size:.9rem; margin:0 0 16px}
.znacznik.ok{background:var(--plyta2); color:var(--akcent2)}
.mono{font-family:ui-monospace,"Cascadia Code",monospace; font-size:.82rem}
.etykieta{font-size:.72rem; letter-spacing:.07em; text-transform:uppercase; color:var(--przygaszony); margin-bottom:3px}
.rzad{display:flex; flex-wrap:wrap; gap:16px; align-items:center; justify-content:space-between}
.akcje{display:flex; gap:8px; align-items:center}
a.przycisk{display:inline-block; background:var(--akcent); color:#fff; text-decoration:none;
  font-weight:600; padding:11px 20px; border-radius:7px}
a.przycisk:hover{filter:brightness(1.08)}
.filtry{display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin:0 0 14px}
.filtry label{margin:0; font-size:.8rem}
.filtry select{font:inherit; padding:7px 10px; border-radius:6px; border:1px solid var(--linia);
  background:var(--plyta); color:var(--tekst)}
.tabela{overflow-x:auto; background:var(--plyta); border:1px solid var(--linia);
  border-radius:10px; box-shadow:var(--cien)}
table{border-collapse:collapse; width:100%; font-size:.9rem; min-width:620px}
th{text-align:left; font-size:.7rem; letter-spacing:.08em; text-transform:uppercase;
  color:var(--przygaszony); padding:10px 14px; border-bottom:1px solid var(--linia);
  background:var(--plyta2); white-space:nowrap}
td{padding:11px 14px; border-bottom:1px solid var(--linia); vertical-align:top; color:var(--tekst2)}
tr:last-child td{border-bottom:none}
</style>
</head>
<body>
{% block pasek %}{% endblock %}
<main class="tresc">
{% block tresc %}{% endblock %}
</main>
</body>
</html>
